# ============================================================

# LMS BACKEND — PRODUCTION ENVIRONMENT TEMPLATE

# ============================================================

#

# This is a PUBLIC template.

# Never put real credentials, passwords, tokens, API keys,

# connection strings, or private keys in this file.

#

# Copy this file to `production.env` on the production server

# and replace the placeholders with real private values.

#

# IMPORTANT:

# `production.env` must NEVER be committed to Git.

# Cloudflare Worker secrets are configured separately.

# ============================================================

# SERVER

# ============================================================

# Production mode

DEBUG=False

# Server port

PORT=3000

# Allowed hosts

ALLOWED_HOSTS=your-api-domain.example.com,localhost,127.0.0.1

# ============================================================

# MONGODB ATLAS

# ============================================================

# MongoDB Atlas connection string

MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# MongoDB database name

MONGO_DB=your-database-name

# ============================================================

# JWT AUTHENTICATION

# ============================================================

# Secret used by the Express backend for JWT authentication.

# Use a long, random secret in production.

JWT_SECRET=your-long-random-jwt-secret

# ============================================================

# CLOUDFLARE R2 STORAGE

# ============================================================

AWS_ACCESS_KEY_ID=your-r2-access-key-id

AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key

AWS_STORAGE_BUCKET_NAME=your-r2-bucket-name

AWS_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

AWS_S3_REGION_NAME=auto

AWS_DEFAULT_ACL=private

AWS_S3_FILE_OVERWRITE=False

# ============================================================

# VIDEO / CONTENT PROCESSING

# ============================================================

# Video segment duration in seconds

VIDEO_SEGMENT_DURATION=10

# Video segment size in bytes

VIDEO_SEGMENT_SIZE=5242880

# Enable content encryption

ENABLE_CONTENT_ENCRYPTION=True

# ============================================================

# CORS

# ============================================================

# Comma-separated list of allowed frontend origins.

CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example.com

# ============================================================

# EMAIL

# ============================================================

# Only configure these if the current backend uses email.

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=[your-email@example.com](mailto:your-email@example.com)
EMAIL_HOST_PASSWORD=your-email-password

# ============================================================

# OPTIONAL

# ============================================================

# Only add additional variables here if they are confirmed to

# be consumed by the current production server.
