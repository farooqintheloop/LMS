# ============================================================
# CLOUDFLARE WORKER CONFIGURATION (wrangler.toml)
# Copy this to wrangler.toml and fill in your project IDs.
# NEVER commit the actual wrangler.toml if it contains real 
# secrets or account-specific IDs.
# ============================================================

name = "lms-api"
main = "workers/simple-lms-api.js"
compatibility_date = "2024-01-01"

# Cloudflare Account Configuration
# DO NOT share your real Account ID publicly.
account_id = "your-cloudflare-account-id"

[vars]
ENVIRONMENT = "production"
API_VERSION = "v1"

# Worker Environment Variables
# For security, only non-sensitive variables should be here.
BACKEND_URL = "https://your-api-domain.example.com"

# Sensitive variables (BACKEND_TOKEN, ADMIN_TOKEN, JWT_SECRET) 
# should be set via wrangler CLI:
# npx wrangler secret put BACKEND_TOKEN
# npx wrangler secret put ADMIN_TOKEN
# npx wrangler secret put JWT_SECRET

[[kv_namespaces]]
binding = "LMS_SESSIONS"
id = "your-kv-namespace-id"
preview_id = "your-kv-preview-id"

[[r2_buckets]]
binding = "LMS_STORAGE"
bucket_name = "lms-storage"
preview_bucket_name = "lms-storage-preview"

[observability]
enabled = true
