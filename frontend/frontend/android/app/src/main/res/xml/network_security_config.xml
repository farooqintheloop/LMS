<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
    
    <!-- Allow HTTPS traffic to Cloudflare -->
    <domain-config>
        <domain includeSubdomains="true">workers.dev</domain>
        <domain includeSubdomains="true">r2.cloudflarestorage.com</domain>
        <domain includeSubdomains="true">your-custom-domain.com</domain>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
